# Copy to .env and fill in locally. NEVER commit .env.
GEMINI_API_KEY=your_google_ai_studio_key_here

# Optional overrides (defaults shown)
GEMINI_MODEL=gemini-3.5-flash-lite
# Comma-separated, tried in order when the primary is rate-limited, overloaded, slow or gone.
# Free-tier quotas are per model (15 requests/minute each), so more models also means more capacity.
# Set it empty (GEMINI_FALLBACK_MODELS=) to disable fallbacks.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite,gemma-4-26b-a4b-it
# Per-call timeout. The Gemini API rejects anything under 10 s, so lower values are raised to 10.
LLM_TIMEOUT_SECONDS=10
# If a model has not answered after this long, the next one starts in parallel (0 = never).
LLM_HEDGE_DELAY_SECONDS=2.5
# Hard cap on time spent on the LLM per request (5-25 s); notes degrade to no_op beyond it.
LLM_TOTAL_BUDGET_SECONDS=20
LLM_MAX_RETRIES=1
LLM_ENABLED=true
LLM_CACHE_SIZE=512
LOG_LEVEL=INFO
PORT=8000
